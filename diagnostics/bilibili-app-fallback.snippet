#!name=B站临时诊断：grpc拒绝与app回退
#!desc=仅验证：新增grpc.biliapi.net域名拒绝，观察App是否更快改走app接口，保留app侧视频/评论净化。grpc专用规则不生效，部分接口可能无法回退。停用其它B站资源，测试后可恢复正式版。
# Baseline: 6e3dcec (ad-removal-first stable resource).
# Sole active change: reject grpc.biliapi.net before attempting its broken transport path.
# Hypothesis only: the App may use app.bilibili.com sooner; fallback speed/coverage is NOT guaranteed.
# Rules matching only grpc cannot execute while the new domain rejection is effective.
# No request replay, host rewriting, DNS alias, scripts, or added network calls.
# Keep the same main configuration, policies, DNS, and capture setting for both test arms.
#!author=kokoryh[https://github.com/kokoryh]
#!qx_version=1.5.2-854
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
# Source: https://kelee.one/Tool/Loon/Lpx/Bilibili_remove_ads.lpx
# 原作者：kokoryh（可莉收录）；固定配置，无需用户参数或 BoxJS。
# 最常访问=hide；移除评论区置顶广告=true；optimizeRequest=false（慢加载反馈后移除重放）；日志=off。
# 不迁移空降助手：不含 DmSegMobile 请求脚本或 bsbsb.top 分流。
# 域名拦截已合并；仅纳入明确属于 B 站的公共补充，停用其它 B 站规则。
# 正式版去广告优先，保留 grpc.biliapi.net 解密以处理视频详情、评论、推荐和动态。
# 最近观看可能变慢；共享主机的相关推荐、评论等也可能受影响，不能仅按页面免解密。
# 插件已提供主机名，无须本地重复添加；停用其它 B 站正式/诊断资源并清除已有 grpc 排除项。
# 无请求拦截/重放；本脚本不能补充 QX 的 HTTP/2 MitM 能力，不能保证 gRPC 净化有效。
# 二进制脚本已适配 QX bodyBytes；本地测试不能代替手机 HTTP/2/gRPC 实测。
# Shared source: https://kelee.one/Tool/Loon/Lpx/Block_HTTPDNS.lpx
host, httpdns.bilivideo.com, reject
host, grpc.biliapi.net, reject
host, api.biliapi.com, reject
host, app.biliapi.com, reject
host, api.biliapi.net, reject
host, app.biliapi.net, reject
host-wildcard, *stun*.chat.bilibili.com, reject
host-wildcard, *tracker*.chat.bilibili.com, reject
host-wildcard, *p2p*.chat.bilibili.com, reject
(?i)^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? url jsonjq-response-body '.data[][]?="stun.chat.bilibili.com:3478"'
(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\? url jsonjq-response-body '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'
(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\? url script-echo-response https://raw.githubusercontent.com/TO8E/loon2qx/main/js/BilibiliKelee/mock.js
(?i)^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\? url jsonjq-response-body '.data.tab = [ { pos: 1, id: 477, name: "推荐" , tab_id: "推荐tab" , uri: "bilibili://pegasus/promo" , default_selected: 1 }, { pos: 2, id: 478, name: "热门" , tab_id: "热门tab" , uri: "bilibili://pegasus/hottopic" }, { pos: 3, id: 545, name: "动画" , tab_id: "bangumi" , uri: "bilibili://pgc/home" }, { pos: 4, id: 151, name: "影视" , tab_id: "film" , uri: "bilibili://pgc/cinema-tab" }, { pos: 5, id: 731, name: "直播" , tab_id: "直播tab" , uri: "bilibili://live/home" } ] | .data.top = [ { pos: 1, id: 176, name: "消息" , tab_id: "消息Top" , uri: "bilibili://link/im_home" , icon: "http://i0.hdslb.com/bfs/archive/d43047538e72c9ed8fd8e4e34415fbe3a4f632cb.png" } ] | .data.bottom = [ { pos: 1, id: 177, name: "首页" , tab_id: "home" , uri: "bilibili://main/home/" , icon: "http://i0.hdslb.com/bfs/archive/63d7ee88d471786c1af45af86e8cb7f607edf91b.png" , icon_selected: "http://i0.hdslb.com/bfs/archive/e5106aa688dc729e7f0eafcbb80317feb54a43bd.png" }, { pos: 2, id: 179, name: "动态" , tab_id: "dynamic" , uri: "bilibili://following/home/" , icon: "http://i0.hdslb.com/bfs/archive/86dfbe5fa32f11a8588b9ae0fccb77d3c27cedf6.png" , icon_selected: "http://i0.hdslb.com/bfs/archive/25b658e1f6b6da57eecba328556101dbdcb4b53f.png" }, { pos: 5, id: 181, name: "我的" , tab_id: "我的Bottom" , uri: "bilibili://user_center/" , icon: "http://i0.hdslb.com/bfs/archive/4b0b2c49ffeb4f0c2e6a4cceebeef0aab1c53fe1.png" , icon_selected: "http://i0.hdslb.com/bfs/archive/a54a8009116cb896e64ef14dcf50e5cade401e00.png" } ]'
(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\? url jsonjq-response-body 'if .data.items then .data.items |= map(select((.banner_item == null) and (.ad_info == null) and (.card_goto == "av") and (.card_type | IN("small_cover_v2", "large_cover_single_v9", "large_cover_v1")))) end'
(?i)^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? url script-echo-response https://raw.githubusercontent.com/TO8E/loon2qx/main/js/BilibiliKelee/mock.js
(?i)^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? url jsonjq-response-body 'del(.data.payment)'
(?i)^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? url jsonjq-response-body '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'
(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\? url jsonjq-response-body 'if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) end'
(?i)^https:\/\/ap[ip]\.bilibili\.com\/x\/(resource\/(top\/activity|patch\/tab(\/v2)?)|v2\/search\/square|vip\/ads\/materials)\? url script-echo-response https://raw.githubusercontent.com/TO8E/loon2qx/main/js/BilibiliKelee/mock.js
(?i)^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? url reject-dict
