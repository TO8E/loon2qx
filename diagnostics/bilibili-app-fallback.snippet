(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url script-echo-response https://raw.githubusercontent.com/TO8E/loon2qx/main/js/BilibiliKelee/mock.js
(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$ url script-echo-response https://raw.githubusercontent.com/TO8E/loon2qx/main/js/BilibiliKelee/mock.js
