hostname = ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com
# 小红书去广告 ← hub.kelee.one/Tool/Loon/Lpx/RedPaper_remove_ads.lpx
# 由 Loon 插件直译
# 由 loon2qx 自动直译，勿手改（改了源插件就重跑 scripts/build_qx_repo.py）
# 说明: 原 AND 规则含 PROTOCOL 条件，QX 无协议匹配；等价做法是在 [general] 加 `udp_drop_list = 443, STUN, QUIC`（你已有 443, STUN）— 原规则: AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)), REJECT…
^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark url reject-img
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action) url reject-dict
^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\? url reject-dict
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide) url reject-dict
^https:\/\/www\.xiaohongshu\.com\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery) url reject-dict
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$ url jsonjq-response-body '.data = {}'
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$ url jsonjq-response-body '.data.items = []'
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint url jsonjq-response-body '.data.hint_words = []'
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\? url jsonjq-response-body '.data.queries = [] | .data.hint_word = {}'
# 脚本 移除图片和实况照片水印
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save) url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除整体配置 ui
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system\/service\/ui\/config\? url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除开屏广告 config
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/config\? url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除开屏广告 splash_config
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除详情页小部件、关注页感兴趣的人
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed) url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除信息流广告
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/followfeed\? url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除详情页感兴趣的人
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\? url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除评论区实况照片水印
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list) url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除图片和视频水印
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed) url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v6\/homefeed\? url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除搜索页广告
^https:\/\/(?:edith|so)\.xiaohongshu\.com\/api\/sns\/v10\/search\/notes\? url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
# 脚本 移除视频水印
^https:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save) url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/RedPaper/RedPaper_remove_ads.js
