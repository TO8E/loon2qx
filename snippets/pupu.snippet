hostname = j1.pupuapi.com
# 朴朴超市去广告 ← hub.kelee.one/Tool/Loon/Lpx/PuPuMall_remove_ads.lpx
# 由 Loon 插件直译
# 由 loon2qx 自动直译，勿手改（改了源插件就重跑 scripts/build_qx_repo.py）
# reject(404) → reject
^https:\/\/j1\.pupuapi\.com\/client\/account\/discount\/order url reject
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100 url reject
# 脚本 移除朴朴超市广告
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7 url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/search_component_banner url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3 url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/app_resource\/resource_preload\/list_h5_resource url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/interests\/products url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1 url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/PuPuMall/PuPuMall_remove_ads.js
