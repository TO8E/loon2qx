hostname = api.xiachufang.com
# 下厨房去广告 ← hub.kelee.one/Tool/Loon/Lpx/XiaChuFang_remove_ads.lpx
# 由 Loon 插件直译
# 由 loon2qx 自动直译，勿手改（改了源插件就重跑 scripts/build_qx_repo.py）
^https:\/\/api\.xiachufang\.com\/v2\/ad\/ url reject-dict
^https:\/\/api\.xiachufang\.com\/v2\/account\/feeds_v7\.json url reject-dict
^https:\/\/api\.xiachufang\.com\/v2\/homepage1810\/init_page\.json url reject-dict
^https:\/\/api\.xiachufang\.com\/v2\/mark_mission\/get_sticker_info\.json url reject-dict
^https:\/\/api\.xiachufang\.com\/v2\/homepage\/paged_waterfall_recommendations\.json$ url jsonjq-response-body 'del(.multiplex_cells[] | select(.recommendation_cell.impression_sensor_events[]?.properties.target_type? == "ad"))'
^https:\/\/api\.xiachufang\.com\/v2\/config\/get\.json$ url jsonjq-response-body 'del(.content.recipe_ad, .content.splash_ad_req_time, .content.splash_sdk_ad_req_time, .content.splash_ad_lifecycle_interval, .content.waterfall_ad_feedback, .content.homepage_waterfall_test_ad_pos, .content.ad_app_look_around, .content.ad_sdk_text_removal_keywords)'
^https:\/\/api\.xiachufang\.com\/v2\/homepage\/ranking_list\/paged_homepage_ranking_list_section_v2\.json$ url jsonjq-response-body '.cells |= map(del(.side_slip_activity_cell, .dish_square_cell))'
