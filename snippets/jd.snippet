hostname = api.m.jd.com
# 京东去广告
# Source: https://kelee.one/Tool/Loon/Lpx/JD_remove_ads.lpx
# Shared source: https://kelee.one/Tool/Loon/Lpx/Block_HTTPDNS.lpx
# Shared source: https://kelee.one/Tool/Loon/Lpx/BlockAdvertisers.lpx
# Generated by loon2qx. See README for compatibility limits.
# 省略无法直接映射的 no-resolve；QX 的解析/匹配流程不保证与 Loon 相同。
# 已并入本 App 的 HTTPDNS/广告域名配套；来源和分配见 config/shared-scope.json。
^http:\/\/\w{32}\.jddebug\.com\/diagnose\? url reject
(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) url reject-dict
(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig url jsonjq-response-body '.data.JDMessage.socketmonitor.isSocketEstablishedAhead = 0 | .data.JDMessage.socketmonitor.isSocketReport = 0 | .data.JDHttpToolKit.httpdns.httpdns = 0'
(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome) url script-response-body https://raw.githubusercontent.com/TO8E/loon2qx/main/js/JD/JD_remove_ads.js
