hostname = api.xiaoheihe.cn
# 小黑盒去广告
# Source: https://kelee.one/Tool/Loon/Lpx/XiaoHeiHe_remove_ads.lpx
# Generated by loon2qx. See README for compatibility limits.
# 原作者：可莉；忠实保留上游 jq 逻辑（删除大写 PROTOCOL，无外部 JS）。
(?i)^https:\/\/api\.xiaoheihe\.cn\/account\/get_ads_info_v2 url reject-dict
(?i)^https:\/\/api\.xiaoheihe\.cn\/bbs\/app\/feeds\/news url jsonjq-response-body '.result.links |= map(if .content_type == 27 then del(.title, .ad_pm, .img_gif, .idea_id, .ad_report, .label, .source, .intranet_only, .ad_cm, .content_type, .PROTOCOL, .img, .ad_ratio) else . end)'
