hostname = www.google.cn, g.cn, google.cn, www.g.cn, ditu.google.cn, maps.google.cn
# Google搜索重定向
# Source: https://kelee.one/Tool/Loon/Lpx/Google.lpx
# Generated by loon2qx. See README for compatibility limits.
# 补齐 HTTPS 匹配主机：g.cn, google.cn, www.g.cn, ditu.google.cn, maps.google.cn
(?i)^https?:\/\/(?:www\.)?(?:g|google)\.cn(?=[/?#]|$)(.*)$ url 307 https://www.google.com$1
(?i)^https?:\/\/(?:ditu|maps)\.google\.cn(?=[/?#]|$)(.*)$ url 307 https://maps.google.com$1
