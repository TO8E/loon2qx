hostname = grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com
# Bilibili 增强：由既有 QX 本地规则移为远程资源，规则行为不变。
# Source: https://raw.githubusercontent.com/kokoryh/Script/master/Surge/module/bilibili.sgmodule
# JSON 底栏适配使用 loon2qx；其余 protobuf、皮肤逻辑沿用原作者。
^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity url jsonjq-response-body '. = {"code":-404,"message":"0","ttl":1,"data":null}'
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\? url reject-dict
https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\? url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bili-suit-diy.js
https:\/\/app\.bilibili\.com\/x\/(v2\/account\/(mine|myinfo\?)|resource\/show\/tab\/v2) url script-response-body __RAW_BASE__/js/Bilibili/bilibili_json.js
https:\/\/app\.bilibili\.com\/x\/v2\/(splash\/(list|show)|feed\/index|search\/square) url script-response-body __RAW_BASE__/js/Bilibili/bilibili_json.js
https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom url script-response-body __RAW_BASE__/js/Bilibili/bilibili_json.js
https:\/\/api\.bilibili\.com\/pgc\/page\/(bangumi|cinema\/tab\?) url script-response-body __RAW_BASE__/js/Bilibili/bilibili_json.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.show\.v1\.Popular\/Index$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view\.v1\.View\/(View|ViewProgress|TFInfo)$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.viewunite\.v1\.View\/View$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmView$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList$ url script-response-body https://raw.githubusercontent.com/kokoryh/Script/master/js/bilibili.protobuf.js
